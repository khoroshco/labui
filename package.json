{
  "name": "labui",
  "version": "0.0.0",
  "description": "Монорепозиторий Banner Lab DS: пакеты, витрина, гейты. Не публикуется; версии живут у пакетов.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "dev": "vite",
    "build:ds": "node scripts/build-ds-react.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "tokens": "node scripts/build-tokens-css.mjs",
    "icons": "node scripts/build-icons.mjs",
    "api": "node scripts/build-api.mjs",
    "prepare": "node scripts/build-tokens-css.mjs",
    "changeset": "changeset",
    "lint": "npm run lint:tokens-source && npm run lint:tokens && npm run lint:props && npm run lint:api && npm run lint:api-react && npm run lint:contracts && npm run lint:icons && npm run lint:vocabulary && npm run lint:showcase && npm run lint:showcase-react",
    "lint:icons": "node scripts/build-icons.mjs --check",
    "lint:api": "node scripts/build-api.mjs --check",
    "lint:changeset": "node scripts/check-changeset.mjs",
    "lint:contracts": "node scripts/check-contracts.mjs",
    "lint:props": "node scripts/check-props.mjs",
    "lint:showcase": "node scripts/check-showcase.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "lint:tokens-source": "node scripts/check-tokens-source.mjs",
    "lint:vocabulary": "node scripts/check-vocabulary.mjs",
    "prebuild:site": "npm run tokens",
    "test": "npm run test:unit && npm run test:smoke && npm run test:visual && npm run test:parity && npm run test:a11y && npm run test:showcase",
    "test:a11y": "playwright test tests/a11y && node scripts/run-pa11y.mjs",
    "test:parity": "playwright test tests/parity",
    "test:smoke": "playwright test tests/smoke",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:visual": "playwright test tests/visual",
    "test:showcase": "playwright test tests/showcase",
    "typecheck": "tsc -p packages/ds-react/tsconfig.json",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "api:react": "node scripts/build-api-react.mjs",
    "lint:api-react": "node scripts/build-api-react.mjs --check",
    "dev:showcase": "vite --config showcase/vite.config.mjs",
    "build:showcase": "npm run api:react && vite build --config showcase/vite.config.mjs",
    "lint:showcase-react": "node scripts/check-showcase-react.mjs"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "pa11y-ci": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "workspaces": [
    "packages/*"
  ]
}
